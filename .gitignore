# ==============================================================================
# CORE PYTHON ECOSYSTEM
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# SECURITY & ENVIRONMENT VARIABLES (CRITICAL)
# ==============================================================================
# Exclude all environment variable definitions to prevent credential leakage.
# This includes production, staging, and development secrets.
.env
.env.*
*.env

# Exception: Allow environment templates (no secrets, safe to commit)
!.env.production.template
!.env.*.template

# Environment file backups (generated by scripts/generate_secrets.sh)
.env.backups/

# Cloudflare IP configuration backups (generated by scripts/update_cloudflare_ips.sh)
.cloudflare-backups/

# SSL/TLS Certificates and Keys
*.pem
*.key
*.crt
*.p12

# ==============================================================================
# VIRTUAL ENVIRONMENTS
# ==============================================================================
# Local Python virtual environments
venv/
.venv/
env/
.env/
ENV/

# ==============================================================================
# DATA ENGINEERING & ETL PIPELINES (dlt, Ibis, DuckDB)
# ==============================================================================
# dlt: Secrets and local cache. Config files (config.toml) are permitted.
.dlt/secrets.toml
.dlt/.cache/

# Local Database Files (DuckDB, SQLite)
# These should not be versioned; use migration scripts (Alembic) instead.
*.duckdb
*.db
*.sqlite3
*.sqlite

# Big Data Artifacts (Parquet, CSV, Excel)
# Prevent committing heavy load datasets to the repository.
*.parquet
*.csv
*.tsv
*.xlsx
*.xls
*.jsonl

# Export and Data directories
data/
exports/
imports/

# ==============================================================================
# DOCKER & INFRASTRUCTURE
# ==============================================================================
# Docker persistent volumes (mapped locally for persistence)
auth_data/
sqlserver_data/
redis_data/
grafana_data/
prometheus_data/

# Local Docker Compose overrides (developer specific configurations)
docker-compose.override.yml

# Container Logs (Rotation managed by Dozzle/Docker drivers, not Git)
*.log

# ==============================================================================
# WEB FRAMEWORK & DASHBOARDING (Flask, Vizro, Gunicorn)
# ==============================================================================
# Flask instance folder
instance/

# Web asset caches
.webassets-cache

# ==============================================================================
# CODE QUALITY & TESTING
# ==============================================================================
# Code coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# Type checking and linter caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/

# ==============================================================================
# IDE & EDITOR CONFIGURATIONS
# ==============================================================================
# VS Code (Exclude user settings, allow workspace extensions recommendations)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Cursor AI Editor
.cursorignore
.cursorindexingignore

# OS generated files
.DS_Store
Thumbs.db

# ==============================================================================
# INFRASTRUCTURE AS CODE (IaC)
# ==============================================================================
# Terraform / OpenTofu local state
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# ==============================================================================
# CLAUDE CODE
# ==============================================================================
# /init -> markdown file
CLAUDE.md